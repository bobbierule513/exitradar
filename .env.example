# ExitRadar environment configuration
# Copy to .env and fill in values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Auth (JWT secret from Supabase project settings) ---
SUPABASE_JWT_SECRET=

# --- Redis / RQ ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Include Docker nginx UI (:8080) and Vite (:5173)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development
# Local: true (in-memory DemoStore). Production: false (Supabase/Postgres).
DEMO_MODE=true

# --- Google Places ---
GOOGLE_PLACES_API_KEY=

# --- LLM (set LLM_PROVIDER to groq | openai | anthropic) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=groq
# Groq default: openai/gpt-oss-120b | OpenAI: gpt-4o-mini | Anthropic: claude-3-5-haiku-20241022
LLM_MODEL=openai/gpt-oss-120b

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
